{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "Default": "Data Source=eduflow.db"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4300"]
  },
  "Jwt": {
    "Issuer": "EduFlow",
    "Audience": "EduFlowClient",
    "AccessTokenMinutes": 60,
    "Key": "REPLACE_WITH_A_32_PLUS_BYTE_RANDOM_SECRET_KEPT_OUT_OF_VCS"
  },
  "OAuth": {
    "FrontendUrl": "http://localhost:4200",
    "RedirectPath": "/oauth/callback",
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
